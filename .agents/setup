#!/usr/bin/env bash
# Prepare a mestack orb. Markdown and shell scripts only: no package
# manager, language toolchain, or backing service.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

step() {
  local name="$1"
  shift
  local start now elapsed
  start="$(date +%s)"
  printf '==> %s\n' "$name"
  "$@"
  now="$(date +%s)"
  elapsed=$((now - start))
  printf '==> %s done (%ss)\n' "$name" "$elapsed"
}

check_tools() {
  local cmd
  for cmd in bash awk grep; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
      printf 'error: missing %s\n' "$cmd" >&2
      exit 1
    fi
  done
}

ensure_executables() {
  chmod +x \
    "$ROOT/install.sh" \
    "$ROOT/scripts/check-skills.sh" \
    "$ROOT/skills/help/scripts/list.sh"
}

step "check tools" check_tools
step "ensure scripts executable" ensure_executables
# install.sh mutates ~/.agents and ~/.grok; do not run it here.
step "check skills" "$ROOT/scripts/check-skills.sh"
